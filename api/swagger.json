{
    "openapi": "3.0.3",
    "info": {
        "title": "Kubernetes RBAC Generator API",
        "description": "A REST API service for visualizing and analyzing Kubernetes Role-Based Access Control (RBAC) configurations. This service provides comprehensive insights into roles, bindings, and principals across your Kubernetes clusters.",
        "version": "1.0.0",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/djryanj/k8s-rbactory-backend",
            "email": "support@example.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        }
    },
    "servers": [
        {
            "url": "http://localhost:8080/api/v1",
            "description": "Local development server"
        },
        {
            "url": "https://api.example.com/api/v1",
            "description": "Production server"
        }
    ],
    "tags": [
        {
            "name": "health",
            "description": "Health check endpoints"
        },
        {
            "name": "cluster",
            "description": "Cluster information endpoints"
        },
        {
            "name": "rbac",
            "description": "RBAC resource endpoints"
        },
        {
            "name": "principals",
            "description": "Principal (users, groups, service accounts) endpoints"
        },
        {
            "name": "relationships",
            "description": "Resource relationship endpoints"
        }
    ],
    "paths": {
        "/healthz": {
            "get": {
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "description": "Returns the health status of the API service",
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                },
                                "example": {
                                    "status": "healthy",
                                    "version": "1.0.0"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/cluster/info": {
            "get": {
                "tags": [
                    "cluster"
                ],
                "summary": "Get cluster information",
                "description": "Returns information about the connected Kubernetes cluster including version, namespaces, and node count",
                "operationId": "getClusterInfo",
                "responses": {
                    "200": {
                        "description": "Cluster information retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ClusterInfo"
                                }
                            }
                        }
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/namespaces": {
            "get": {
                "tags": [
                    "cluster"
                ],
                "summary": "List namespaces",
                "description": "Returns all namespaces in the cluster",
                "operationId": "listNamespaces",
                "responses": {
                    "200": {
                        "description": "Namespaces retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NamespaceList"
                                }
                            }
                        }
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/counts": {
            "get": {
                "tags": [
                    "rbac"
                ],
                "summary": "Get resource counts",
                "description": "Returns counts of all RBAC resources in the cluster",
                "operationId": "getCounts",
                "responses": {
                    "200": {
                        "description": "Resource counts retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResourceCounts"
                                }
                            }
                        }
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/roles": {
            "get": {
                "tags": [
                    "rbac"
                ],
                "summary": "List roles",
                "description": "Returns a paginated list of Kubernetes roles, optionally filtered by namespace",
                "operationId": "listRoles",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/NamespaceQuery"
                    },
                    {
                        "$ref": "#/components/parameters/Limit"
                    },
                    {
                        "$ref": "#/components/parameters/Offset"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Roles retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RBACList"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/roles/{namespace}/{name}": {
            "get": {
                "tags": [
                    "rbac"
                ],
                "summary": "Get role",
                "description": "Returns a specific Kubernetes role by namespace and name",
                "operationId": "getRole",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/NamespacePath"
                    },
                    {
                        "$ref": "#/components/parameters/NamePath"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Role retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RBACResource"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/clusterroles": {
            "get": {
                "tags": [
                    "rbac"
                ],
                "summary": "List cluster roles",
                "description": "Returns a paginated list of Kubernetes cluster roles",
                "operationId": "listClusterRoles",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Limit"
                    },
                    {
                        "$ref": "#/components/parameters/Offset"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cluster roles retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RBACList"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/clusterroles/{name}": {
            "get": {
                "tags": [
                    "rbac"
                ],
                "summary": "Get cluster role",
                "description": "Returns a specific Kubernetes cluster role by name",
                "operationId": "getClusterRole",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/NamePath"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cluster role retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RBACResource"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/rolebindings": {
            "get": {
                "tags": [
                    "rbac"
                ],
                "summary": "List role bindings",
                "description": "Returns a paginated list of Kubernetes role bindings, optionally filtered by namespace",
                "operationId": "listRoleBindings",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/NamespaceQuery"
                    },
                    {
                        "$ref": "#/components/parameters/Limit"
                    },
                    {
                        "$ref": "#/components/parameters/Offset"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Role bindings retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RBACList"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/clusterrolebindings": {
            "get": {
                "tags": [
                    "rbac"
                ],
                "summary": "List cluster role bindings",
                "description": "Returns a paginated list of Kubernetes cluster role bindings",
                "operationId": "listClusterRoleBindings",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Limit"
                    },
                    {
                        "$ref": "#/components/parameters/Offset"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cluster role bindings retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RBACList"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/principals": {
            "get": {
                "tags": [
                    "principals"
                ],
                "summary": "List principals",
                "description": "Returns a paginated list of all principals (users, groups, service accounts) with their associated bindings and roles",
                "operationId": "listPrincipals",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/NamespaceQuery"
                    },
                    {
                        "$ref": "#/components/parameters/Limit"
                    },
                    {
                        "$ref": "#/components/parameters/Offset"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Principals retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PrincipalList"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/relationships/{kind}/{namespace}/{name}": {
            "get": {
                "tags": [
                    "relationships"
                ],
                "summary": "Get resource relationships (namespaced)",
                "description": "Returns relationship information for a specific namespaced resource, including related roles and bindings",
                "operationId": "getRelationshipsNamespaced",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/KindPath"
                    },
                    {
                        "$ref": "#/components/parameters/NamespacePath"
                    },
                    {
                        "$ref": "#/components/parameters/NamePath"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Relationships retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RelationshipResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        },
        "/relationships/{kind}/{name}": {
            "get": {
                "tags": [
                    "relationships"
                ],
                "summary": "Get resource relationships (cluster-scoped)",
                "description": "Returns relationship information for a specific cluster-scoped resource, including related roles and bindings",
                "operationId": "getRelationshipsClusterScoped",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/KindPath"
                    },
                    {
                        "$ref": "#/components/parameters/NamePath"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Relationships retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RelationshipResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalServerError"
                    }
                }
            }
        }
    },
    "components": {
        "parameters": {
            "NamespaceQuery": {
                "name": "namespace",
                "in": "query",
                "description": "Filter by namespace (empty for all namespaces)",
                "required": false,
                "schema": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                    "maxLength": 253
                },
                "example": "default"
            },
            "NamespacePath": {
                "name": "namespace",
                "in": "path",
                "description": "Namespace of the resource",
                "required": true,
                "schema": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                    "maxLength": 253
                },
                "example": "default"
            },
            "NamePath": {
                "name": "name",
                "in": "path",
                "description": "Name of the resource",
                "required": true,
                "schema": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                    "maxLength": 253
                },
                "example": "pod-reader"
            },
            "KindPath": {
                "name": "kind",
                "in": "path",
                "description": "Kind of the resource",
                "required": true,
                "schema": {
                    "type": "string",
                    "enum": [
                        "Role",
                        "ClusterRole",
                        "RoleBinding",
                        "ClusterRoleBinding",
                        "User",
                        "Group",
                        "ServiceAccount"
                    ]
                },
                "example": "Role"
            },
            "Limit": {
                "name": "limit",
                "in": "query",
                "description": "Maximum number of items to return",
                "required": false,
                "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 20
                },
                "example": 20
            },
            "Offset": {
                "name": "offset",
                "in": "query",
                "description": "Number of items to skip",
                "required": false,
                "schema": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                },
                "example": 0
            }
        },
        "schemas": {
            "HealthResponse": {
                "type": "object",
                "required": [
                    "status",
                    "version"
                ],
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "Health status of the service",
                        "example": "healthy"
                    },
                    "version": {
                        "type": "string",
                        "description": "Version of the API",
                        "example": "1.0.0"
                    }
                }
            },
            "ClusterInfo": {
                "type": "object",
                "required": [
                    "version",
                    "namespaces",
                    "nodeCount"
                ],
                "properties": {
                    "version": {
                        "type": "string",
                        "description": "Kubernetes cluster version",
                        "example": "v1.28.0"
                    },
                    "namespaces": {
                        "type": "array",
                        "description": "List of namespaces in the cluster",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "default",
                            "kube-system",
                            "kube-public"
                        ]
                    },
                    "nodeCount": {
                        "type": "integer",
                        "description": "Number of nodes in the cluster",
                        "example": 3
                    }
                }
            },
            "NamespaceList": {
                "type": "object",
                "required": [
                    "namespaces"
                ],
                "properties": {
                    "namespaces": {
                        "type": "array",
                        "description": "List of namespace names",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "default",
                            "kube-system"
                        ]
                    }
                }
            },
            "ResourceCounts": {
                "type": "object",
                "required": [
                    "roles",
                    "clusterRoles",
                    "roleBindings",
                    "clusterRoleBindings",
                    "principals"
                ],
                "properties": {
                    "roles": {
                        "type": "integer",
                        "description": "Number of roles",
                        "example": 45
                    },
                    "clusterRoles": {
                        "type": "integer",
                        "description": "Number of cluster roles",
                        "example": 78
                    },
                    "roleBindings": {
                        "type": "integer",
                        "description": "Number of role bindings",
                        "example": 52
                    },
                    "clusterRoleBindings": {
                        "type": "integer",
                        "description": "Number of cluster role bindings",
                        "example": 63
                    },
                    "principals": {
                        "type": "integer",
                        "description": "Number of unique principals",
                        "example": 34
                    }
                }
            },
            "RBACResource": {
                "type": "object",
                "required": [
                    "kind",
                    "name",
                    "createdAt"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "description": "Resource kind",
                        "enum": [
                            "Role",
                            "ClusterRole",
                            "RoleBinding",
                            "ClusterRoleBinding"
                        ],
                        "example": "Role"
                    },
                    "name": {
                        "type": "string",
                        "description": "Resource name",
                        "example": "pod-reader"
                    },
                    "namespace": {
                        "type": "string",
                        "description": "Resource namespace (for namespaced resources)",
                        "example": "default"
                    },
                    "rules": {
                        "type": "array",
                        "description": "Policy rules (for roles)",
                        "items": {
                            "$ref": "#/components/schemas/PolicyRule"
                        }
                    },
                    "subjects": {
                        "type": "array",
                        "description": "Subjects (for bindings)",
                        "items": {
                            "$ref": "#/components/schemas/Subject"
                        }
                    },
                    "roleRef": {
                        "$ref": "#/components/schemas/RoleRef"
                    },
                    "labels": {
                        "type": "object",
                        "description": "Resource labels",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "example": {
                            "app": "example"
                        }
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Creation timestamp",
                        "example": "2024-01-01T00:00:00Z"
                    }
                }
            },
            "PolicyRule": {
                "type": "object",
                "required": [
                    "apiGroups",
                    "resources",
                    "verbs"
                ],
                "properties": {
                    "apiGroups": {
                        "type": "array",
                        "description": "API groups",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            ""
                        ]
                    },
                    "resources": {
                        "type": "array",
                        "description": "Resource types",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "pods"
                        ]
                    },
                    "resourceNames": {
                        "type": "array",
                        "description": "Specific resource names (optional)",
                        "items": {
                            "type": "string"
                        }
                    },
                    "verbs": {
                        "type": "array",
                        "description": "Allowed verbs",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "get",
                            "list"
                        ]
                    }
                }
            },
            "Subject": {
                "type": "object",
                "required": [
                    "kind",
                    "name"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "description": "Subject kind",
                        "enum": [
                            "User",
                            "Group",
                            "ServiceAccount"
                        ],
                        "example": "ServiceAccount"
                    },
                    "name": {
                        "type": "string",
                        "description": "Subject name",
                        "example": "default"
                    },
                    "namespace": {
                        "type": "string",
                        "description": "Subject namespace (for ServiceAccounts)",
                        "example": "default"
                    }
                }
            },
            "RoleRef": {
                "type": "object",
                "required": [
                    "kind",
                    "name",
                    "apiGroup"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "description": "Role kind",
                        "enum": [
                            "Role",
                            "ClusterRole"
                        ],
                        "example": "Role"
                    },
                    "name": {
                        "type": "string",
                        "description": "Role name",
                        "example": "pod-reader"
                    },
                    "apiGroup": {
                        "type": "string",
                        "description": "API group",
                        "example": "rbac.authorization.k8s.io"
                    }
                }
            },
            "RBACList": {
                "type": "object",
                "required": [
                    "items",
                    "totalCount"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "description": "List of RBAC resources",
                        "items": {
                            "$ref": "#/components/schemas/RBACResource"
                        }
                    },
                    "totalCount": {
                        "type": "integer",
                        "description": "Total number of items",
                        "example": 45
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Items per page",
                        "example": 20
                    },
                    "offset": {
                        "type": "integer",
                        "description": "Number of items skipped",
                        "example": 0
                    },
                    "hasMore": {
                        "type": "boolean",
                        "description": "Whether more items are available",
                        "example": true
                    }
                }
            },
            "Principal": {
                "type": "object",
                "required": [
                    "kind",
                    "name",
                    "bindingCount",
                    "roleCount"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "description": "Principal kind",
                        "enum": [
                            "User",
                            "Group",
                            "ServiceAccount"
                        ],
                        "example": "ServiceAccount"
                    },
                    "name": {
                        "type": "string",
                        "description": "Principal name",
                        "example": "default"
                    },
                    "namespace": {
                        "type": "string",
                        "description": "Principal namespace (for ServiceAccounts)",
                        "example": "default"
                    },
                    "bindingCount": {
                        "type": "integer",
                        "description": "Number of bindings",
                        "example": 2
                    },
                    "roleCount": {
                        "type": "integer",
                        "description": "Number of unique roles",
                        "example": 1
                    },
                    "bindings": {
                        "type": "array",
                        "description": "List of binding names",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "binding1",
                            "binding2"
                        ]
                    },
                    "roles": {
                        "type": "array",
                        "description": "List of role references",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "Role:pod-reader"
                        ]
                    }
                }
            },
            "PrincipalList": {
                "type": "object",
                "required": [
                    "items",
                    "totalCount"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "description": "List of principals",
                        "items": {
                            "$ref": "#/components/schemas/Principal"
                        }
                    },
                    "totalCount": {
                        "type": "integer",
                        "description": "Total number of principals",
                        "example": 34
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Items per page",
                        "example": 20
                    },
                    "offset": {
                        "type": "integer",
                        "description": "Number of items skipped",
                        "example": 0
                    },
                    "hasMore": {
                        "type": "boolean",
                        "description": "Whether more items are available",
                        "example": true
                    }
                }
            },
            "RelationshipResponse": {
                "type": "object",
                "properties": {
                    "role": {
                        "$ref": "#/components/schemas/RBACResource"
                    },
                    "binding": {
                        "$ref": "#/components/schemas/RBACResource"
                    },
                    "relatedBindings": {
                        "type": "array",
                        "description": "Related bindings",
                        "items": {
                            "$ref": "#/components/schemas/RBACResource"
                        }
